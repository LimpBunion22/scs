{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch scs_demo",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/scs_demo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build",
      "miDebuggerPath": "/usr/bin/gdb",
      "logging": {
        "moduleLoad": false,
        "programOutput": true,
        "trace": false
      },
      "internalConsoleOptions": "openOnSessionStart",
      "linux": {
        "MIMode": "gdb"
      },
      "windows": {
        "MIMode": "gdb"
      }
    }
  ]
}
